<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monitor AquaSmart — Arduino R4 WiFi"
        android:textColor="@color/aquaDark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Conecta el teléfono a la red WiFi del Arduino (AP: AquaSmartAP / clave: aquasmart123) y usa la IP 192.168.4.1."
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="IP del Arduino">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:text="192.168.4.1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWiFiConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🔗 Conectar / consultar estado" />

    <TextView
        android:id="@+id/tvEstadoArduino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#E3F2FD"
        android:padding="8dp"
        android:textSize="15sp"
        android:typeface="monospace"
        android:text="Sin datos todavía" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLedOnWiFi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/aquaDark"
            android:text="💡 Prender LED" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLedOffWiFi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/soil"
            android:text="🌑 Apagar LED" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWiFiLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="#F1F5F9"
        android:padding="8dp"
        android:textSize="12sp"
        android:typeface="monospace"
        android:scrollbars="vertical" />

</LinearLayout>
